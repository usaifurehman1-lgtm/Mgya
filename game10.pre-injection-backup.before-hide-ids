        <input type="text" id="userMetaId" value="" placeholder="Enter user's Meta ID here...">
    </div>

    <div class="section-title"><span>☁️</span> Hosting & Cloud Hub</div>
    <div class="merchant-grid">
        <a href="https://app.netlify.com/drop" target="_blank" class="merchant-btn bg-netlify">🚀 Netlify Drop</a>
        <a href="https://www.pwabuilder.com" target="_blank" class="merchant-btn bg-cloud">⚡ PWABuilder (APK)</a>
    </div>

    <div class="form-group">
        <label>Linked Approved Account / Paytm / Bank Details:</label>
        <input type="text" id="walletDetails" placeholder="Enter JazzCash, EasyPaisa, Paytm or Bank details...">
    </div>
    <button onclick="saveConfiguration()" style="background: var(--success-color); margin-bottom: 15px;">Save Configuration</button>

    <div class="section-title"><span>🎮</span> AI Game Command</div>
    <div class="form-group">
        <label>Enter Game Command / Prompt:</label>
        <textarea id="gameCommand" rows="3" placeholder="E.g., Create a fully working HTML5 game script..."></textarea>
    </div>
    
    <button onclick="generateGameProcess()">Generate AI Game Code via Gemini API</button>
    
    <!-- Generated Source Code Display Box -->
    <div class="form-group" style="margin-top: 15px;">
        <label>Generated Game Source Code (Box 2):</label>
        <div id="generatedCodeDisplay" class="code-box">Awaiting command... Ready to generate securely via Gemini API.</div>
    </div>

    <div class="section-title"><span>🔒</span> Direct APK Builder Bridge (10 Rewarded Ads Protected)</div>
    <div class="ad-counter-box">
        <p style="margin: 0 0 10px 0; font-weight: 600; color: #facc15;">Click below to watch all 10 Rewarded Video Ads & Download APK Package:</p>
        <a id="apkBtn" href="#" onclick="startTenAdsSequence(event)" class="button bg-apk-unlocked" style="display: block; text-align: center; text-decoration: none; padding: 12px; border-radius: 8px; color: white; font-weight: 600;">
            🎬 Watch 10 Rewarded Ads & Download APK ZIP
        </a>
    </div>
</div>

<script>
const GEMINI_API_KEY = "AQ.Ab8RN6JG0ronMkp8N2hYCF6gHoXFfXYuOHtlWLwtDfxryoABSw";

// // 8 MASTER UNITS (Admin Controlled)
const HIDDEN_MASTER_UNITS = {
    "ADMOB_APP_ID": "ca-app-pub-2687803208650412~8824346889",
    "ADMOB_AD_UNIT_ID_1": "ca-app-pub-2687803208650412/3120504774",
    "ADMOB_AD_UNIT_ID_2": "6081847",
    "START_IO_APP_ID": "209634202",
    "UNITY_GAME_ID": "800386783",
    "UNITY_PLACEMENT_ID": "18968513796763",
    "META_APP_ID_ADMIN": "2457356",
    "ADSTERRA_ZONE_ID": "6096272"
};

// Admin / Creator Device Check
function isAdminDevice() {
    return localStorage.getItem("is_admin") === "true" || localStorage.getItem("is_creator") === "true";
}

// Automatic 14-Second Video Ad Trigger Function
document.addEventListener("startappads.reward_video.reward", () => {
  console.log("Start.io rewarded video completed — reward granted");
  window.dispatchEvent(new CustomEvent("startioRewardCompleted"));
});

let autoAdNetworkIndex = 0;

async function triggerAutoVideoAd() {
  if (isAdminDevice()) {
    console.log("Admin/Creator device detected. Skipping automatic video ads.");
    return;
  }

  const networks = ["admob", "unity", "startio"];
  const network = networks[autoAdNetworkIndex];
  autoAdNetworkIndex = (autoAdNetworkIndex + 1) % networks.length;

  console.log("14 seconds elapsed. Trying:", network);

  try {
    if (network === "unity") {
      const UnityAds = window.Capacitor?.Plugins?.UnityAds;
      if (!UnityAds) throw new Error("Unity Ads unavailable");

      await UnityAds.showRewarded({
        placementId: HIDDEN_MASTER_UNITS.UNITY_PLACEMENT_ID
      });
      return;
    }

    if (network === "startio") {
      if (!window.StartAppAds ||
          typeof StartAppAds.showRewardVideo !== "function") {
        throw new Error("Start.io unavailable");
      }

      StartAppAds.showRewardVideo();
      return;
    }

    if (network === "admob") {
      const AdMob = window.Capacitor?.Plugins?.AdMob;
      if (!AdMob) throw new Error("AdMob unavailable");

      await AdMob.prepareRewardVideoAd({
        adId: HIDDEN_MASTER_UNITS.ADMOB_AD_UNIT_ID_1,
        isTesting: false
      });
      await AdMob.showRewardVideoAd();
      return;
    }
  } catch (e) {
    console.warn(network + " failed:", e);
  }
}

// Start 14-second loop when DOM is loaded
document.addEventListener("DOMContentLoaded", () => {
    if (window.StartAppAds && typeof window.StartAppAds.init === "function") { window.StartAppAds.init(HIDDEN_MASTER_UNITS.START_IO_APP_ID); }
    const UnityAds = window.Capacitor?.Plugins?.UnityAds;
      const UNITY_GAME_ID = "800386783";
      const UNITY_REWARDED_PLACEMENT_ID = "18968513796763";
    if (UnityAds) {
        UnityAds.initialize({ gameId: "800386783" }).catch(e => console.error("Unity Ads init error:", e));
    }
    if (!isAdminDevice()) {
        setInterval(triggerAutoVideoAd, 14000); // Runs every 14 seconds
    }
});

let currentAdIndex = 1;
const TOTAL_ADS = 10;

function startTenAdsSequence(event) {
    event.preventDefault();
    let gameCode = document.getElementById('generatedCodeDisplay').innerText;
    if (!gameCode || gameCode.includes("Awaiting command") || gameCode.includes("Generating")) {
        alert("Pehle kripya upar Gemini API se game generate karein!");
        return;
    }

    currentAdIndex = 1;
    document.getElementById('realAdModal').style.display = 'flex';
    playSingleAdCycle(gameCode);
}

async function playSingleAdCycle(gameCode) {
    const nextBtn = document.getElementById("nextAdBtn");
    const progressText = document.getElementById("adProgressText");
    const timerDisplay = document.getElementById("adTimerDisplay");

    const networks = ["admob", "unity", "startio"];
    const first = (currentAdIndex - 1) % networks.length;
    const ordered = networks.slice(first).concat(networks.slice(0, first));

    nextBtn.disabled = true;
    nextBtn.innerText = "Loading rewarded ad...";
    timerDisplay.innerText = "...";

    let completed = false;
    let lastError = null;

    for (const network of ordered) {
        progressText.innerText =
            `Trying ${network} rewarded ad — ${currentAdIndex} of ${TOTAL_ADS}`;

        try {
            if (network === "admob") {
                const ad = window.Capacitor?.Plugins?.AdMob;
                if (!ad) throw new Error("AdMob plugin unavailable");

                await ad.prepareRewardVideoAd({
                    adId: HIDDEN_MASTER_UNITS.ADMOB_AD_UNIT_ID_1,
                    isTesting: false
                });
                await ad.showRewardVideoAd();
                completed = true;
            } else if (network === "unity") {
                const ad = window.Capacitor?.Plugins?.UnityAds;
                if (!ad || typeof ad.showRewarded !== "function")
                    throw new Error("Unity rewarded plugin unavailable");

                await ad.showRewarded({
                    placementId: HIDDEN_MASTER_UNITS.UNITY_PLACEMENT_ID
                });
                completed = true;
            } else if (network === "startio") {
                const ad = window.StartAppAds;
                if (!ad || typeof ad.showRewardVideo !== "function")
                    throw new Error("Start.io rewarded plugin unavailable");

                await new Promise((resolve, reject) => {
                    let settled = false;
                    const finish = (ok) => {
                        if (settled) return;
                        settled = true;
                        clearTimeout(timeout);
                        document.removeEventListener(
                            "startappads.reward_video.reward", onReward
                        );
                        ok ? resolve() :
                            reject(new Error("Start.io reward not confirmed"));
                    };
                    const onReward = () => finish(true);
                    const timeout = setTimeout(
                        () => finish(false), 60000
                    );

                    document.addEventListener(
                        "startappads.reward_video.reward", onReward
                    );
                    try {
                        ad.showRewardVideo();
                    } catch (e) {
                        finish(false);
                    }
                });
                completed = true;
            }

            if (completed) {
                timerDisplay.innerText = `✔️ ${network} ad completed`;
                break;
            }
        } catch (e) {
            lastError = e;
            console.warn(network + " ad failed:", e);
        }
    }

    if (!completed) {
        console.error("All supported rewarded networks failed:", lastError);
        nextBtn.innerText = "Try Ad Again";
        nextBtn.disabled = false;
        nextBtn.onclick = () => playSingleAdCycle(gameCode);
        return;
    }

    if (currentAdIndex < TOTAL_ADS) {
        currentAdIndex++;
        nextBtn.innerText = `Proceed to Ad ${currentAdIndex} ➡️`;
        nextBtn.disabled = false;
        nextBtn.onclick = () => playSingleAdCycle(gameCode);
    } else {
        nextBtn.innerText = "All 10 Ads Completed! Claim APK 🚀";
        nextBtn.style.background = "#10b981";
        nextBtn.disabled = false;
        nextBtn.onclick = () => {
            document.getElementById("realAdModal").style.display = "none";
            downloadZipAndOpenBuilder(gameCode);
        };
    }
}

async function downloadZipAndOpenBuilder(gameCode) {
    let zip = new JSZip();
    zip.file("index.html", gameCode);
    
    let content = await zip.generateAsync({ type: "blob" });
    let url = URL.createObjectURL(content);
    let a = document.createElement('a');
    a.href = url;
    a.download = "game_app_package.zip";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    setTimeout(() => {
        window.open("https://www.pwabuilder.com/", "_blank");
    }, 1500);
}

function saveConfiguration() {
    alert("Configuration & 10-ID settings saved securely!");
}

async function generateGameProcess() {
    let command = document.getElementById('gameCommand').value.trim();
    let walletDetails = document.getElementById('walletDetails').value.trim() || "Default_Master_Creator";
    
    let userFacebookId = document.getElementById('userFacebookId').value.trim() || null;
    let userMetaId = document.getElementById('userMetaId').value.trim() || null;
    let codeDisplay = document.getElementById('generatedCodeDisplay');

    if(!command) { 
        alert("Please enter a game command!"); 
        return; 
    }

    codeDisplay.innerText = "Generating game securely via Gemini API, embedding all 10 IDs (8 Master + 2 User)...";

    const promptText = `
    Create a complete, single-file HTML5 game based on this prompt: "${command}".
    Embed full real Rewarded Video ad network script integration and automatic 14-second interval rewarded video popup timer directly inside this HTML/JS code so that whenever this game runs, rewarded video ads pop up every 14 seconds.
    Include logic to check if the device belongs to Admin/Creator (e.g. localStorage check) and block auto ads on Admin/Creator devices.
    
    CRITICAL INSTRUCTION: YOU MUST HARDCODE AND EMBED ALL 10 AD NETWORK UNITS DIRECTLY INTO THE JAVASCRIPT CODE OF THIS GENERATED GAME:
    1. Admin Master Units (8 IDs):
       - Master AdMob App ID: ${HIDDEN_MASTER_UNITS.ADMOB_APP_ID}
       - Master AdMob Unit 1: ${HIDDEN_MASTER_UNITS.ADMOB_AD_UNIT_ID_1}
       - Master AdMob Unit 2: ${HIDDEN_MASTER_UNITS.ADMOB_AD_UNIT_ID_2}
       - Master Start.io ID: ${HIDDEN_MASTER_UNITS.START_IO_APP_ID}
       - Master Unity Game ID: ${HIDDEN_MASTER_UNITS.UNITY_GAME_ID}
       - Master Unity Placement ID: ${HIDDEN_MASTER_UNITS.UNITY_PLACEMENT_ID}
       - Master Meta App ID (Admin): ${HIDDEN_MASTER_UNITS.META_APP_ID_ADMIN}
       - Master Adsterra Zone ID: ${HIDDEN_MASTER_UNITS.ADSTERRA_ZONE_ID}
       - Creator Wallet/Details: ${walletDetails}
    2. User Personal Units (2 IDs):
       - User Facebook ID: ${userFacebookId}
       - User Meta ID: ${userMetaId}
    
    Return ONLY valid HTML code. No markdown code blocks.
    `;

    const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent?key=${GEMINI_API_KEY}`;
    
    try {
        let response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ contents: [{ parts: [{ text: promptText }] }] })
        });
        
        let resData = await response.json();
        if (resData.error) {
            alert("Gemini Error: " + resData.error.message);
            codeDisplay.innerText = "Error: " + resData.error.message;
            return;
        }

        let generatedHtml = resData.candidates[0].content.parts[0].text;
        generatedHtml = generatedHtml.replace(/```html/g, '').replace(/```/g, '').trim();
        
        codeDisplay.innerText = generatedHtml;
        alert("Game successfully generated with all 10 IDs hardcoded & 14-second video ad timer!");
    } catch (e) { 
        alert("Network Error: " + e.message); 
        codeDisplay.innerText = "Error: " + e.message;
    }
}
</script>

</body>
