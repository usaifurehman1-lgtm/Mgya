        #realAdModal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 9999; justify-content: center; align-items: center; }
        .modal-content { background: #1e293b; padding: 25px; border-radius: 12px; text-align: center; max-width: 450px; width: 90%; border: 1px solid var(--border-color); }
    </style>
</head>
<body>

