        .section-title { font-size: 16px; font-weight: 700; color: #fff; margin: 20px 0 10px 0; border-top: 1px solid var(--border-color); padding-top: 15px; display: flex; align-items: center; gap: 8px; }
        
        .merchant-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 15px; }
        .merchant-btn { padding: 10px; border-radius: 8px; color: white; text-align: center; text-decoration: none; font-weight: 600; font-size: 13px; display: flex; align-items: center; justify-content: center; gap: 6px; }
        .bg-jazz { background: #ef4444; }
        .bg-easy { background: #22c55e; }
        .bg-hbl { background: #1d4ed8; }
        .bg-meezan { background: #047857; }
        .bg-alfalah { background: #dc2626; }
        .bg-abl { background: #2563eb; }
        .bg-paytm { background: #0ea5e9; }
        .bg-netlify { background: #0ea5e9; }
